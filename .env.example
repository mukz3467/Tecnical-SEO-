# Gemini API (only needed if using the AI features)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public app URL
APP_URL="https://your-deployment.example"

# Google Search Console: choose ONE credentials method.
# Option A (recommended): complete service-account JSON stored as one server-side secret.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","token_uri":"https://oauth2.googleapis.com/token"}'
#
# Option B: separate service-account fields.
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL="service-account@your-project.iam.gserviceaccount.com"
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
#
# Optional exact property override; use sc-domain:example.com OR https://www.example.com/ as shown in Search Console.
# GOOGLE_SEARCH_CONSOLE_PROPERTY_URL="sc-domain:example.com"
# The service account must be granted access to the exact verified property in Search Console.
# Enable the Google Search Console API in the Google Cloud project.
# Sitemap submission and URL Inspection are different operations. Ordinary pages cannot be
# manually submitted through a public Request Indexing API.

# Optional: Google PageSpeed Insights API key.
# Without this key, the app reports crawl-observed findings only and does not invent CWV scores.
# PAGESPEED_API_KEY="YOUR_PAGESPEED_API_KEY"

# Optional: GitHub token for authorized repository operations. Keep it server-side.
# GITHUB_TOKEN="YOUR_GITHUB_TOKEN"
